{
  "name": "mcp-riksa",
  "version": "0.4.0",
  "description": "Local-first MCP server and agent evaluation workbench",
  "type": "module",
  "license": "MIT",
  "author": "Irfan Sofyana Putra",
  "homepage": "https://github.com/irfansofyana/mcp-riksa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfansofyana/mcp-riksa.git"
  },
  "bugs": {
    "url": "https://github.com/irfansofyana/mcp-riksa/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "eval",
    "testing",
    "workbench",
    "cli"
  ],
  "bin": {
    "mcp-riksa": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/CONFIGURATION.md",
    "docs/SUITES.md",
    "docs/PLAYGROUND.md",
    "docs/CLI.md",
    "docs/SECURITY.md",
    "docs/DEVELOPMENT.md",
    "docs/screenshots/stdio-server.png",
    "docs/screenshots/secrets.png",
    "docs/screenshots/desktop.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts serve --dev",
    "serve": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/src/cli/index.js serve",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/conformance": "0.1.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "oauth4webapi": "^3.8.7",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.29.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
